# Copy to .env and fill in from your Supabase project (Project Settings > API). The publishable
# key is meant for browsers: row level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where Margin is served. It must match the Supabase Site URL, because auth emails link here.
VITE_SITE_URL=http://localhost:5173

# Optional: a Cloudflare Turnstile site key, when CAPTCHA protection is on in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
