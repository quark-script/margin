{
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!assets/|_vercel/|api/|sw.js|workbox-|manifest.webmanifest|.*\\.(?:png|svg|ico|woff2)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(p|s|shared|oauth|auth)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(login|signup|settings)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30
    },
    "api/oauth-protected-resource.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  }
}
